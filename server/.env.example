# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Real local or cloud MongoDB URI)
# Local example: mongodb://127.0.0.1:27017/smart_school_connect
# Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_school_connect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/smart_school_connect

# Frontend Client URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# API Prefix
API_PREFIX=/api/v1

# JWT Configuration
# IMPORTANT: Replace with a strong random secret in production. Never expose this value.
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# AI / LLM Configuration (Optional - for future AI integrations)
# GEMINI_API_KEY=your_gemini_api_key_here
